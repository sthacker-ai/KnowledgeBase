KNOWLEDGEBASE_CONTENT_DIR=./content
OBSIDIAN_VAULT_DIR=
KB_ADMIN_TOKEN=

# ─── X/Twitter import ────────────────────────────────────────────────────────
SCRAPE_TARGET_HANDLE=your_x_handle
X_STORAGE_STATE_PATH=./data/private/x-storage-state.json
SCRAPE_DAILY_LIMIT=10
SCRAPE_REQUEST_DELAY_MIN_MS=1400
SCRAPE_REQUEST_DELAY_MAX_MS=3200
SCRAPE_MAX_SCROLLS=40
SCRAPE_IDLE_SCROLL_LIMIT=6

# X cookie auth (from browser DevTools > Application > Cookies > https://x.com)
# This is the PRIMARY session-renewal method — see docs/x-importer.md.
# Automated headed login (npm run import:x-login) is blocked by X bot
# detection for some accounts; the manual cookie copy below is the one that
# reliably works. Run `npm run import:x-cookies` after setting these.
X_AUTH_TOKEN=your_x_auth_token_here
X_CT0=your_x_ct0_token_here

# Days before a saved session is considered expired (see docs/x-importer.md
# for why this exists — it must not be shorter than the cookies' real TTL).
X_SESSION_TTL_DAYS=365

# ─── AI Provider (text) ───────────────────────────────────────────────────────
# Chain: OpenRouter primary -> OpenRouter fallback -> NVIDIA NIM -> Ollama.
# Exact free-tier model IDs change periodically; scripts/lib/ai-client.js is
# the source of truth if these defaults look stale.

OPENROUTER_API_KEY=
OPENROUTER_MODEL_PRIMARY=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_MODEL_FALLBACK=qwen/qwen3-235b-a22b:free

# NVIDIA NIM (comma-separated list, tried in order)
NVIDIA_API_KEY=
NVIDIA_MODELS=mistralai/mistral-nemotron,meta/llama-3.1-8b-instruct

# Local Ollama (always used as last-resort fallback)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:e2b

# ─── Video / Transcription ────────────────────────────────────────────────────
# Whisper model size: tiny | base | small | medium | large-v3
# small = good default. medium = better for technical content.
WHISPER_MODEL=small

# Groq — fast, free-tier transcription (whisper-large-v3-turbo). Falls back
# to local faster-whisper (CPU, slower) if unset.
GROQ_API_KEY=

# ─── Hero images ──────────────────────────────────────────────────────────────
# Replicate FLUX Schnell — PAID, ~$0.003/image, 16:9. Note the exact,
# unconventional casing: this is the literal env var name the code reads.
Replicate_API-Key=

# ─── Podcast TTS ──────────────────────────────────────────────────────────────
# Kokoro 82M via OpenRouter's /audio/speech endpoint (uses OPENROUTER_API_KEY
# above — no separate key needed). Optional GPU upgrade path:
ORPHEUS_API_URL=

# ─── Database (optional) ──────────────────────────────────────────────────────
# Learning tracker, run history, token usage. /runs and /tokens fall back to
# local JSON files if this is unset or unreachable.
DATABASE_URL=
